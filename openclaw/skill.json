{
  "name": "ehcmall_db_explain",
  "display_name": "EHC Mall DB 테이블 설명",
  "description": "유진홈센터 이커머스 DB의 테이블·컬럼 메타데이터를 조회합니다. 테이블 개요, 도메인, 순위, 컬럼 한글 라벨 등을 JSON으로 반환합니다.",
  "version": "1.0.0",
  "type": "http",
  "http": {
    "method": "GET",
    "base_url": "https://YOUR_API_HOST",
    "path": "/v1/explain",
    "query_params": [
      {
        "name": "table",
        "type": "string",
        "required": true,
        "description": "조회할 테이블 이름 (예: SA_SALE_DETAIL, IN_RECVPAY_MTH_CLOSE_PARTITION)"
      },
      {
        "name": "column",
        "type": "string",
        "required": false,
        "description": "컬럼 코드 (선택). 지정 시 해당 컬럼의 한글 라벨만 반환."
      }
    ],
    "response_type": "json",
    "max_response_tokens": 400
  }
}
